<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#3A3D45"
                android:endColor="#2A2D35"
                android:angle="45" />
            <corners android:radius="24dp" />
            <padding
                android:left="8dp"
                android:right="8dp"
                android:top="6dp"
                android:bottom="6dp" />
        </shape>
    </item>
    <!-- Unselected state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>